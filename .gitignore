# Sources for repo-backed targets, cloned at runtime (e.g. faultline).
# limeyard vendors no third-party source: targets are fetched, never checked in.
targets/*/*/src/

# Local, machine-specific compose override
docker-compose.override.yml

# Local env
.env

# crAPI generates a JWT keypair into its keys dir on first boot
targets/api/crapi/keys/*
!targets/api/crapi/keys/.gitkeep

# UI build output
control/ui/node_modules/
control/ui/build/
control/ui/.svelte-kit/

# Editor and local machine config
.idea/
.vscode/

# python bytecode (from local checks)
__pycache__/
*.pyc
