# Absolute path to this checkout on the host. limed drives the host Docker
# daemon through the mounted socket, so target compose paths must resolve to
# real host paths, not paths inside the control container.
#   cp .env.example .env && echo "LIMEYARD_DIR=$PWD" >> .env
LIMEYARD_DIR=/absolute/path/to/limeyard
MONITOR_INTERVAL=30

# Shared secret for the limed API. REQUIRED.
#
# limed drives the host Docker daemon through the mounted socket, which is
# root-equivalent on this machine, and it has to share a network with the
# targets so setup hooks can reach them. Docker bridges are bidirectional, so
# "limed can reach targets but targets cannot reach limed" cannot be expressed
# in compose. This token is what makes reachability insufficient: a target that
# gets popped can open a socket to limed and learn nothing.
#
#   echo "LIME_TOKEN=$(openssl rand -hex 24)" >> .env
LIME_TOKEN=
